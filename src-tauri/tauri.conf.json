{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scisiam",
  "version": "0.1.0",
  "identifier": "com.scisiam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "launcher"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src https://scisiam-app.vercel.app; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "SciSiam",
    "shortDescription": "SciSiam Virtual Lab for Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Thai"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Thai": "languages/Thai.nsh"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["scisiam"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRkFDRkJEM0RFNzYwOEIKUldTTFlPYzl2Yy82RUFYL01jMEREQVBUMDRWYlRJODF2dEZTQ1BjL25oSnUvVERmeDc5c3ZPcDIK",
      "endpoints": [
        "https://github.com/Woraphob3938/Scisiam_webapp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
